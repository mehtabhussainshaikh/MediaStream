{
  "info": {
    "name": "MediaStream Backend API",
    "description": "Backend baseline collection. Set baseUrl, email, and password. Login stores accessToken; Postman's cookie jar retains the refresh cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "name", "value": "Media User" },
    { "key": "email", "value": "media.user@example.com" },
    { "key": "password", "value": "change-this-password" },
    { "key": "accessToken", "value": "" },
    { "key": "mediaId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ready', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ready'); });"] } }]
        },
        {
          "name": "OpenAPI JSON",
          "request": { "method": "GET", "url": "{{baseUrl}}/api-docs.json" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('authenticated', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.collectionVariables.set('accessToken', body.data.accessToken); });"] } }]
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('rotated', () => { pm.response.to.have.status(200); pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken); });"] } }]
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('accessToken', '');"] } }]
        }
      ]
    },
    {
      "name": "Media",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "title", "value": "Demo media", "type": "text" },
                { "key": "description", "value": "Uploaded from Postman", "type": "text" },
                { "key": "tags", "value": "demo,postman", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/media"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created', () => { pm.response.to.have.status(201); pm.collectionVariables.set('mediaId', pm.response.json().data.media._id); });"] } }]
        },
        {
          "name": "Search Media",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/media?q=demo&sort=relevance&page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "v1", "media"], "query": [{ "key": "q", "value": "demo" }, { "key": "sort", "value": "relevance" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "My Uploads",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/media/mine?page=1&limit=20" }
        },
        {
          "name": "Media Details",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/media/{{mediaId}}" }
        },
        {
          "name": "Update Media Metadata",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated demo media\",\n  \"description\": \"Updated through Postman\",\n  \"tags\": [\"demo\", \"updated\"]\n}" },
            "url": "{{baseUrl}}/api/v1/media/{{mediaId}}"
          }
        },
        {
          "name": "Increment View",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/media/{{mediaId}}/view" }
        },
        {
          "name": "Delete Media",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/media/{{mediaId}}" }
        }
      ]
    }
  ]
}
